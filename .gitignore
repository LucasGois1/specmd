# Local artifacts and cache; the tool's final paths are still to be chosen.
.DS_Store
**/.specmd/cache/
**/.specmd/tmp/
**/.specmd/local/

# Local credentials are never part of the project's documentation.
.env
.env.*
!.env.example
*.pem
*.key

# Dependencies and artifacts of the local experiments.
**/.venv/
**/node_modules/
**/target/
**/__pycache__/
**/.pytest_cache/
**/.tools/
**/.cache/
**/*.class
**/*.egg-info/
build/
dist/
