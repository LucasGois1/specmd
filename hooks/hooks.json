{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${SPECMD_PYTHON:-python3}\" \"${PLUGIN_ROOT}/scripts/codex_hook.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${SPECMD_PYTHON:-python3}\" \"${PLUGIN_ROOT}/scripts/codex_hook.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${SPECMD_PYTHON:-python3}\" \"${PLUGIN_ROOT}/scripts/codex_hook.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
